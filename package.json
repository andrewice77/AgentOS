{
  "name": "agentos",
  "version": "0.1.0",
  "description": "Local-first personal desktop AI agent",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/fix-tauri-paths.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "smoke": "bash scripts/smoke_test.sh",
    "start:release": "npm run build && env WEBKIT_DISABLE_DMABUF_RENDERER=1 CARGO_TARGET_DIR=src-tauri/target cargo run --release --manifest-path src-tauri/Cargo.toml"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.13",
    "marked": "^18.0.10",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/three": "^0.185.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
