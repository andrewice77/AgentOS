{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentOS",
  "version": "0.1.0",
  "identifier": "com.andrewice.agentos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "avatar",
        "title": "AgentOS",
        "width": 168,
        "height": 252,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "chat",
        "title": "AgentOS Chat",
        "width": 400,
        "height": 560,
        "minWidth": 320,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": true
      },
      {
        "label": "main",
        "title": "AgentOS — Console",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
